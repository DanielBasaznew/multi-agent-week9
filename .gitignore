cat << 'EOF' > .gitignore
# Environments & Secrets
.env
.env.*
venv/
env/
ENV/
.venv/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# CrewAI & Vector Store local databases/storage
.crewai/
chroma_db/
.lancedb/
*.db
*.sqlite3

# IDEs & OS Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
EOF